#!/bin/sh
# Run a command as the rootless "lightcycles" user, which owns the game's
# containers. Installed to /usr/local/bin/lcctl by setup.sh. Examples:
#
#   lcctl podman logs -f lightcycles
#   lcctl systemctl --user restart lightcycles
#   lcctl systemctl --user start podman-auto-update   # deploy now
set -eu
uid=$(id -u lightcycles)
cd /
exec sudo -u lightcycles -H env \
	XDG_RUNTIME_DIR="/run/user/$uid" \
	DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
	"$@"
